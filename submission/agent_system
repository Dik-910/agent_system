#!/usr/bin/env bash
set -euo pipefail

# 进程起点（epoch 秒，纳秒精度）：交给 Python 侧做「启动/等待/执行」三段计时。
# 平台上报的 case 耗时 = 容器启动 + 我们全部工作的 wall time，其中「容器启动 +
# 解释器导入 + 环境探针」这段我们自己看不见（python 里的表是从任务开始才起的）。
# 有一次 t2/case2 平台 113.7s、日志只记到 35.8s，差的 78s 一直无法归因 —— 有了
# 这个时间戳，下次直接就能看出是启动慢、还是等 input 慢。
export SCAN_AGENT_T0="${SCAN_AGENT_T0:-$(date +%s.%N)}"

# ============================================================================
# Scan Insertion Agent 入口脚本
# ============================================================================
#
# 功能：
#   1. 解析命令行参数
#   2. 验证输入输出目录
#   3. 启动 Python Agent 主程序
#
# 参数：
#   -input  <DIR>  输入目录（包含 task_spec.md, limitations.md 等）
#   -output <DIR>  输出目录（用于保存 decision_log.json 等结果）
#
# 返回值：
#   0 - 成功
#   1 - Agent 执行失败
#   2 - 参数错误
#   3 - 目录不存在
# ============================================================================

INPUT_DIR=""
OUTPUT_DIR=""

# 解析命令行参数
while [[ $# -gt 0 ]]; do
  case "$1" in
    -input|--input)
      INPUT_DIR="${2:-}"
      shift 2
      ;;
    -output|--output)
      OUTPUT_DIR="${2:-}"
      shift 2
      ;;
    *)
      # 忽略未知参数（Codabench 可能传递额外参数）
      shift
      ;;
  esac
done

# 验证必需参数
if [[ -z "$INPUT_DIR" || -z "$OUTPUT_DIR" ]]; then
  echo "错误: 缺少必需参数" >&2
  echo "用法: $0 -input <输入目录> -output <输出目录>" >&2
  exit 2
fi

# 验证目录存在
if [[ ! -d "$INPUT_DIR" ]]; then
  echo "错误: 输入目录不存在: $INPUT_DIR" >&2
  exit 3
fi

# 创建输出目录
mkdir -p "$OUTPUT_DIR" || {
  echo "错误: 无法创建输出目录: $OUTPUT_DIR" >&2
  exit 3
}

# 显示运行信息
echo "========================================"
echo "  Scan Insertion Agent"
echo "========================================"
echo "输入目录: $INPUT_DIR"
echo "输出目录: $OUTPUT_DIR"
echo ""

# 启动 Python Agent
cd /submission
exec python3 -m scan_agent --input "$INPUT_DIR" --output "$OUTPUT_DIR"
